  "businessContracts": {
    "daily": [
      "Budget weeks follow income cycles, not necessarily calendar weeks or months",
      "Each main income starts a new cycle, even before the previous cycle ends",
      "Payday rule is monthly day 15, moved to preceding weekday if weekend",
      "Cycle spendable = pockets.spendable",
      "Usable balance = spendable + buffer + fixedReserved",
      "Total cycle money = usable balance + reserve",
      "Main income fills only the fixed-reserve shortfall",
      "Main-income UI uses fixed reserve/buffer amounts, not legacy savingsRate/bufferRate controls",
      "Weekly rollover: 60% buffer, 40% reserve, subject to buffer cap",
      "Cycle rollover moves 40% of existing buffer to reserve",
      "Prepaid payment deducts now and reports on effectiveDate; preserve both dates",
      "Transfers are internal and do not count as income or expense",
      "Historical balance snapshots are immutable; missing snapshots omit calculation process",
      "Show uncovered expenses as funding gaps, not fabricated pocket deductions"
    ],
    "copper": [
      "Cash total = liquid + reserve; total assets = cash total + inventory cost",
      "Profit = sale amount - sale cost; negative profit is valid",
      "Positive-profit sale: cost returns to liquid; profit splits by configured ratios",
      "Non-positive-profit sale: sale cash enters liquid",
      "Purchase reduces cash and increases inventory cost",
      "Sale cost must not exceed inventory cost; purchase must not exceed available cash",
      "Pending sale already affects cash and inventory when created",
      "Confirmation only changes status; auto-confirm after 10 natural days when app processes it",
      "Cancellation rolls back cash/inventory and excludes the sale from stats/charts",
      "Deleting an already-cancelled sale does not roll back a second time",
      "Legacy locked records cannot be deleted",
      "Inventory supplementation/stocktake is not a cash purchase"
    ],
    "displayClarifications": [
      "Calibratable balance includes spendable + buffer + fixedReserved, excludes reserve",
      "weekRemaining is clamped at zero; show overage separately from weekSpent and allowance",
      "Large/prepaid allocation.advance may use the entire spendable pocket, not only future-week balance"
    ]
  },
